#!/bin/sh
# Strips AI attribution lines from commit messages (see AGENTS.md).
# Enable once per clone:  git config core.hooksPath .githooks
msg="$1"
tmp="$msg.tmp.$$"
grep -viE '^[[:space:]]*co-authored-by:.*(claude|anthropic|codex|openai|copilot|cursor|gemini|chatgpt|gpt|\[bot\]|noreply@(anthropic|openai)\.com)|generated (with|by) .*(claude|codex|copilot|cursor|chatgpt|gemini|ai)' "$msg" > "$tmp"
# Drop trailing blank lines left behind.
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg"
rm -f "$tmp"
